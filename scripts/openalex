#!/usr/bin/env node
import { readFileSync, realpathSync, writeFileSync } from 'node:fs';
import { pathToFileURL } from 'node:url';
// OpenAlex works query helper.
// Zero dependencies — uses Node 18+ built-in fetch.
//
// As a module:
//   import { countWorks, countByLicense, buildWorksUrl, DOMAINS } from './openalex.mjs';
//   await countWorks({ oa: true, domain: 'life-sciences' });
//
// As a CLI:
//   node openalex.mjs count --oa --domain life-sciences
//   node openalex.mjs count --oa --domain life-sciences --license cc-by,cc-by-sa
//   node openalex.mjs count --oa --domain life-sciences --pmids out.csv
//   node openalex.mjs by-license --oa --domain life-sciences
//   node openalex.mjs sample --oa --domain life-sciences
//   node openalex.mjs url --oa --domain life-sciences --license cc-by
//   node openalex.mjs license 23008161 24302613 [--pmcid|--doi] [--file ids.txt] [--json]

const API = 'https://api.openalex.org/works';

// Set this (or OPENALEX_MAILTO env var) to join OpenAlex's faster "polite pool".
const DEFAULT_MAILTO = process.env.OPENALEX_MAILTO || '';

// Free API key (https://openalex.org/settings/api), required by OpenAlex for
// cursor paging (--pmids paginating past page 1). --api-key overrides.
const DEFAULT_API_KEY = process.env.OPENALEX_API_KEY || '';

// When true, getJson prints the equivalent curl command to stderr before fetching.
let SHOW_CURL = false;
/** Enable/disable printing the reproducing curl command (module API). */
export function setShowCurl(on = true) { SHOW_CURL = !!on; }

// Domain name -> OpenAlex domain ID (verified against the live API).
export const DOMAINS = {
  'life-sciences': 1,
  'social-sciences': 2,
  'physical-sciences': 3,
  'health-sciences': 4,
};

// Valid license values for best_oa_location.license / locations.license.
export const LICENSES = [
  'cc-by', 'cc-by-sa', 'cc-by-nd',
  'cc-by-nc', 'cc-by-nc-sa', 'cc-by-nc-nd',
  'public-domain', 'other-oa',
];

/**
 * Build the OpenAlex filter string from options.
 *
 * @param {object} opts
 * @param {boolean} [opts.oa]            Require open access (open_access.is_oa:true).
 * @param {string|number} [opts.domain]  Domain name ('life-sciences') or numeric ID.
 * @param {boolean} [opts.anyTopic]      Match domain in ANY topic (topics.domain.id)
 *                                        instead of only the primary one.
 * @param {string|string[]} [opts.license]  One or more license values (OR'd together).
 * @param {string} [opts.oaStatus]       e.g. 'gold', 'green', 'hybrid', 'diamond'.
 * @param {boolean} [opts.useLocations]  Use locations.license instead of
 *                                        best_oa_location.license (looser match).
 * @param {object} [opts.extra]          Extra raw filter pairs, e.g. { publication_year: 2024 }.
 * @returns {string} comma-joined filter string
 */
export function buildFilter(opts = {}) {
  const parts = [];

  if (opts.oa) parts.push('open_access.is_oa:true');

  if (opts.domain != null) {
    const id = typeof opts.domain === 'number' ? opts.domain : DOMAINS[opts.domain];
    if (id == null) {
      throw new Error(
        `Unknown domain '${opts.domain}'. Known: ${Object.keys(DOMAINS).join(', ')}`
      );
    }
    const key = opts.anyTopic ? 'topics.domain.id' : 'primary_topic.domain.id';
    parts.push(`${key}:${id}`);
  }

  if (opts.license) {
    const list = Array.isArray(opts.license) ? opts.license : [opts.license];
    const key = opts.useLocations ? 'locations.license' : 'best_oa_location.license';
    parts.push(`${key}:${list.join('|')}`); // '|' = OR within a single filter
  }

  if (opts.oaStatus) parts.push(`open_access.oa_status:${opts.oaStatus}`);

  if (opts.extra) {
    for (const [k, v] of Object.entries(opts.extra)) parts.push(`${k}:${v}`);
  }

  return parts.join(','); // ',' = AND across filters
}

/** Build a full /works URL (filter + any query params). */
export function buildWorksUrl(opts = {}, params = {}) {
  const url = new URL(API);
  const filter = buildFilter(opts);
  if (filter) url.searchParams.set('filter', filter);
  const mailto = opts.mailto ?? DEFAULT_MAILTO;
  if (mailto) url.searchParams.set('mailto', mailto);
  const apiKey = opts.apiKey ?? DEFAULT_API_KEY;
  if (apiKey) url.searchParams.set('api_key', apiKey);
  for (const [k, v] of Object.entries(params)) url.searchParams.set(k, String(v));
  return url.toString();
}

async function getJson(url) {
  if (SHOW_CURL) {
    // Print the reproducing curl command to stderr so stdout stays parsable.
    process.stderr.write(`curl -s '${url}'\n`);
  }
  const res = await fetch(url, { headers: { Accept: 'application/json' } });
  if (!res.ok) {
    const body = await res.text().catch(() => '');
    throw new Error(`OpenAlex ${res.status} ${res.statusText}: ${body.slice(0, 300)}`);
  }
  return res.json();
}

/**
 * Return the total count of works matching the filters (meta.count).
 * Only pulls one minimal record, never the full result set.
 */
export async function countWorks(opts = {}) {
  const url = buildWorksUrl(opts, { 'per-page': 1, select: 'id' });
  const data = await getJson(url);
  return data.meta.count;
}

/**
 * Return a random sample of works matching the filters.
 * Uses OpenAlex's `sample` param (requires per-page; seed makes it reproducible).
 *
 * @param {object} opts        same filter options as countWorks
 * @param {number} [n=5]        how many works to sample (max 10,000 per OpenAlex)
 * @param {number} [opts.seed]  fixed seed for a reproducible sample
 * @returns {Promise<Array<{id,doi,title}>>}
 */
export async function sampleWorks(opts = {}, n = 5) {
  const params = { sample: n, 'per-page': n, select: 'id,doi,title' };
  if (opts.seed != null) params.seed = opts.seed;
  const url = buildWorksUrl(opts, params);
  const data = await getJson(url);
  return data.results.map((w) => ({ id: w.id, doi: w.doi, title: w.title }));
}

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

/**
 * Cursor-paginate through ALL works matching the filters and collect the
 * PMID (bare digits) of each work that has one. Works without a PMID are
 * skipped. Uses cursor paging rather than per-page/page, which caps out at
 * 10,000 results.
 *
 * @param {object} opts             same filter options as countWorks
 * @param {object} [page]
 * @param {number} [page.sleepMs]   pause between page requests (default 120
 *                                  ms, to stay well under the 10 req/s limit)
 * @returns {Promise<{pmids: string[], scanned: number}>}
 */
export async function fetchPmids(opts = {}, { sleepMs = 120 } = {}) {
  const pmids = [];
  let scanned = 0;
  let cursor = '*';
  while (cursor) {
    const url = buildWorksUrl(opts, { cursor, 'per-page': 200, select: 'id,ids' });
    const data = await getJson(url);
    const results = data.results ?? [];
    scanned += results.length;
    for (const w of results) {
      const pmid = normalizePmid(w.ids?.pmid ?? '');
      if (pmid) pmids.push(pmid);
    }
    const next = data.meta?.next_cursor;
    cursor = next && results.length ? next : null;
    if (cursor && sleepMs > 0) await sleep(sleepMs);
  }
  return { pmids, scanned };
}

/** Write PMIDs to a CSV file: a 'pmid' header, then one PMID per line. */
export function writePmidsCsv(file, pmids) {
  // PMIDs are digits only, so no escaping is needed.
  writeFileSync(file, `pmid\n${pmids.join('\n')}\n`);
}

/**
 * Normalize a PMCID to canonical 'PMC<digits>' form.
 * Accepts 'PMC3535092', '3535092', and PMC URLs
 * ('https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3535092/').
 */
export function normalizePmcid(raw) {
  const s = String(raw).trim();
  const bare = s.match(/^(?:PMC)?(\d+)$/i);
  if (bare) return `PMC${bare[1]}`;
  const url = s.match(/PMC(\d+)/i);
  if (url) return `PMC${url[1]}`;
  return null;
}

/** Normalize a PMID: bare digits or a pubmed.ncbi.nlm.nih.gov URL. */
export function normalizePmid(raw) {
  const s = String(raw).trim();
  const m = s.match(/^(\d+)$/) || s.match(/pubmed\.ncbi\.nlm\.nih\.gov\/(\d+)\/?$/i);
  return m ? m[1] : null;
}

/**
 * Normalize a DOI to canonical lowercase '10.<registrar>/<suffix>' form.
 * Accepts bare DOIs, 'doi:...', and https://doi.org/... URLs.
 */
export function normalizeDoi(raw) {
  const s = String(raw).trim()
    .replace(/^https?:\/\/(?:dx\.)?doi\.org\//i, '')
    .replace(/^doi:\s*/i, '')
    .toLowerCase()
    .replace(/\.$/, '');
  return /^10\.\S+\/\S+$/.test(s) ? s : null;
}

// External-ID lookups against /works: which ids.* field to filter on and how
// to normalize both the input and each work's stored ID value.
const ID_FILTERS = {
  pmid: { key: 'pmid', filter: 'ids.pmid', normalize: normalizePmid },
  // NB: the filter is 'doi:', not 'ids.doi:' ('ids.*' filters only exist for
  // openalex/doi/mag/pmid/pmcid-as-pmid prefixes documented per-field).
  doi: { key: 'doi', filter: 'doi', normalize: normalizeDoi },
};

/**
 * Batch-query /works for works whose external ID is one of `ids`, returning a
 * Map from normalized ID to the matching work. Batches stay well under
 * OpenAlex's 100-value OR limit (and URL length limits).
 */
async function searchWorksByIds({ key, filter, normalize }, ids, opts = {}) {
  const found = new Map();
  const BATCH = 50;
  for (let i = 0; i < ids.length; i += BATCH) {
    const batch = ids.slice(i, i + BATCH);
    const url = buildWorksUrl(
      { ...opts, extra: { ...opts.extra, [filter]: batch.join('|') } },
      { 'per-page': 100, select: 'id,ids,open_access,best_oa_location' }
    );
    const data = await getJson(url);
    for (const w of data.results ?? []) {
      const nk = normalize(w.ids?.[key] ?? '');
      if (nk) found.set(nk, w);
    }
  }
  return found;
}

/** Extract the license/OA summary from a work (all null when absent). */
function licenseRow(work) {
  return {
    license: work?.best_oa_location?.license ?? null,
    is_oa: work?.open_access?.is_oa ?? null,
    id: work?.id ?? null,
    doi: work?.ids?.doi ?? null,
  };
}

const NCBI_IDCONV = 'https://pmc.ncbi.nlm.nih.gov/tools/idconv/api/v1/articles/';

/**
 * Map PMCIDs to PMIDs via NCBI's ID Converter. IDs PMC can't resolve are
 * omitted from the result.
 */
async function pmcidsToPmids(pmcids, opts = {}) {
  const out = new Map();
  const BATCH = 100; // idconv accepts up to 200 comma-separated IDs per call
  for (let i = 0; i < pmcids.length; i += BATCH) {
    const url = new URL(NCBI_IDCONV);
    url.searchParams.set('ids', pmcids.slice(i, i + BATCH).join(','));
    url.searchParams.set('format', 'json');
    url.searchParams.set('tool', 'openalex-cli');
    const mailto = opts.mailto ?? DEFAULT_MAILTO;
    if (mailto) url.searchParams.set('email', mailto);
    const data = await getJson(url);
    for (const rec of data.records ?? []) {
      if (rec.pmcid && rec.pmid) out.set(String(rec.pmcid).toUpperCase(), String(rec.pmid));
    }
  }
  return out;
}

/**
 * Look up the OpenAlex license category (best_oa_location.license) and
 * open-access flag (open_access.is_oa) for a list of identifiers.
 * Input order is preserved; unmatched inputs come back with null fields.
 *
 * @param {string[]} ids
 * @param {object} [opts]
 * @param {'pmid'|'pmcid'|'doi'} [opts.idMode='pmid']  ID type of `ids`.
 *   'pmcid' first maps each PMCID to a PMID via NCBI's ID Converter, then
 *   queries OpenAlex by PMID (OpenAlex currently indexes no PMCIDs directly);
 *   rows then carry both `pmcid` and `pmid` (null when NCBI can't resolve it).
 * @param {string} [opts.mailto]  used for the NCBI/OA polite pools
 * @returns {Promise<Array<object>>}
 */
export async function licenseById(ids, opts = {}) {
  const { idMode = 'pmid', ...rest } = opts;
  const input = Array.isArray(ids) ? ids : [ids];

  const normalize = idMode === 'pmcid' ? normalizePmcid : ID_FILTERS[idMode]?.normalize;
  if (!normalize) throw new Error(`Unknown id mode '${idMode}' (want pmid, pmcid, or doi)`);

  const forms = {
    pmid: "want bare digits, e.g. '23008161'",
    pmcid: "want 'PMC<digits>', e.g. 'PMC3535092'",
    doi: "want a DOI like '10.1038/nature14539'",
  };
  const invalid = input.filter((x) => normalize(x) == null);
  if (invalid.length) {
    throw new Error(`Invalid ${idMode.toUpperCase()}(s): ${invalid.join(', ')} (${forms[idMode]})`);
  }
  const unique = [...new Set(input.map(normalize))];

  if (idMode === 'pmcid') {
    const pmcidToPmid = await pmcidsToPmids(unique, rest);
    const pmids = [...new Set(pmcidToPmid.values())];
    const found = pmids.length ? await searchWorksByIds(ID_FILTERS.pmid, pmids, rest) : new Map();
    return unique.map((pmcid) => {
      const pmid = pmcidToPmid.get(pmcid) ?? null;
      return { pmcid, pmid, ...licenseRow(pmid ? found.get(pmid) ?? null : null) };
    });
  }

  const spec = ID_FILTERS[idMode];
  const found = await searchWorksByIds(spec, unique, rest);
  // The keyed ID goes last so the row consistently reports the normalized
  // input form (licenseRow's doi is the URL form stored on the work).
  return unique.map((key) => ({ ...licenseRow(found.get(key) ?? null), [spec.key]: key }));
}

/**
 * Return a { license: count } breakdown for the given filters via group_by.
 * One request returns a bucket per license.
 */
export async function countByLicense(opts = {}) {
  const groupKey = opts.useLocations ? 'locations.license' : 'best_oa_location.license';
  // Don't send a license filter when grouping by license.
  const { license, ...rest } = opts;
  const url = buildWorksUrl(rest, { group_by: groupKey });
  const data = await getJson(url);
  const out = {};
  for (const g of data.group_by) {
    const key = g.key_display_name || g.key.split('/').pop();
    out[key] = g.count;
  }
  return out;
}

// ---------------------------------------------------------------------------
// CLI
// ---------------------------------------------------------------------------

/** Split PMCID list text (from --file or stdin) on whitespace and commas. */
function splitIds(text) {
  return String(text).split(/[\s,]+/).filter(Boolean);
}

function parseArgs(argv) {
  const opts = {};
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    switch (a) {
      case '--oa': opts.oa = true; break;
      case '--any-topic': opts.anyTopic = true; break;
      case '--use-locations': opts.useLocations = true; break;
      case '--json': opts.json = true; break;
      case '--pmcid': case '--doi': {
        const mode = a.slice(2);
        if (opts.idMode && opts.idMode !== mode) {
          throw new Error(`Can't combine --${opts.idMode} and ${a}.`);
        }
        opts.idMode = mode;
        break;
      }
      case '--domain': opts.domain = argv[++i]; break;
      case '--license': opts.license = argv[++i].split(','); break;
      case '--oa-status': opts.oaStatus = argv[++i]; break;
      case '--mailto': opts.mailto = argv[++i]; break;
      case '--seed': opts.seed = Number(argv[++i]); break;
      case '--curl': SHOW_CURL = true; break;
      case '--file': case '-f': opts.file = argv[++i]; break;
      case '--pmids': opts.pmids = argv[++i]; break;
      case '--api-key': opts.apiKey = argv[++i]; break;
      case '-n': case '--count-n': opts.n = Number(argv[++i]); break;
      case '--year': opts.extra = { ...opts.extra, publication_year: argv[++i] }; break;
      default:
        if (a.startsWith('-')) throw new Error(`Unknown flag: ${a}`);
        (opts.positionals ??= []).push(a);
    }
  }
  // domain may be numeric
  if (opts.domain != null && /^\d+$/.test(opts.domain)) opts.domain = Number(opts.domain);
  return opts;
}

async function main() {
  const [cmd, ...rest] = process.argv.slice(2);
  if (!cmd || cmd === 'help' || cmd === '--help') {
    console.log(`OpenAlex works helper

Usage:
  node openalex.mjs count       [filters] [--pmids out.csv]
                                          # total matching works (meta.count)
                                          # --pmids also writes the PubMed ID
                                          # of every matching work to a CSV
  node openalex.mjs by-license  [filters]   # count per license (group_by)
  node openalex.mjs sample      [filters]   # sample of matching works
  node openalex.mjs url         [filters]   # print the API URL only
  node openalex.mjs license     ID [ID...] [--pmcid|--doi] [--file ids.txt] [--json]
                                          # license + open-access flag per work

The license command looks works up by PMID by default. --pmcid treats inputs
as PMCIDs and maps them to PMIDs via NCBI's ID Converter first (OpenAlex
currently indexes no PMCIDs itself); --doi treats inputs as DOIs. IDs come
from the arguments, --file (whitespace/comma separated, '-' for stdin), or
stdin when neither is given. Unmatched IDs show '(not found)'/'(no PMID in PMC)'.

Filters:
  --oa                      require open access
  --domain <name|id>        ${Object.keys(DOMAINS).join(' | ')} (or numeric ID)
  --license a,b,c           license values, OR'd (${LICENSES.join(', ')})
  --oa-status <status>      gold | green | hybrid | bronze | diamond | closed
  --year <YYYY>             publication_year
  --any-topic               match domain in any topic, not just the primary
  --use-locations           use locations.license instead of best_oa_location.license
  --mailto <email>          join OpenAlex polite pool
  --api-key <key>           OpenAlex API key (or OPENALEX_API_KEY env var);
                            required by OpenAlex for cursor paging (--pmids
                            past the first 200 results)
  -n <N>                    number of works for 'sample' (default 5)
  --pmids <file.csv>        'count' only: also write every matching work's
                            PMID (one per line) to a CSV (works without one
                            are skipped)
  --seed <N>                fixed seed for a reproducible sample
  --curl                    also print the equivalent curl command (to stderr)

Examples:
  node openalex.mjs sample --oa --domain life-sciences
  node openalex.mjs sample --oa --domain life-sciences --license cc-by -n 5

Examples:
  node openalex.mjs count --oa --domain life-sciences
  node openalex.mjs count --oa --domain life-sciences --license cc-by,cc-by-sa,cc-by-nc
  node openalex.mjs count --oa --domain life-sciences --license cc-by --pmids pmids.csv
  node openalex.mjs by-license --oa --domain life-sciences
  node openalex.mjs license 23008161 24302613
  node openalex.mjs license --pmcid PMC3535092 PMC3908754
  node openalex.mjs license --file pmids.txt --json`);
    return;
  }

  const opts = parseArgs(rest);
  if (opts.pmids && cmd !== 'count') {
    throw new Error(`--pmids is only valid with 'count', not '${cmd}'.`);
  }

  if (cmd === 'url') {
    const params = cmd === 'url' ? { 'per-page': 1, select: 'id' } : {};
    console.log(buildWorksUrl(opts, params));
    return;
  }
  if (cmd === 'count') {
    const n = await countWorks(opts);
    console.log(n.toLocaleString());
    if (opts.pmids) {
      const { pmids, scanned } = await fetchPmids(opts);
      writePmidsCsv(opts.pmids, pmids);
      process.stderr.write(
        `# wrote ${pmids.length.toLocaleString()} PMIDs to ${opts.pmids} ` +
        `(${scanned.toLocaleString()} works scanned, ` +
        `${(scanned - pmids.length).toLocaleString()} without a PMID)\n`
      );
    }
    return;
  }
  if (cmd === 'sample') {
    const n = opts.n ?? 5;
    const works = await sampleWorks(opts, n);
    if (!works.length) {
      console.log('No matching works found.');
      return;
    }
    for (const w of works) {
      console.log(w.id);
      if (w.doi) console.log(`  doi:   ${w.doi}`);
      if (w.title) console.log(`  title: ${w.title}`);
    }
    return;
  }
  if (cmd === 'by-license') {
    const rows = await countByLicense(opts);
    const total = Object.values(rows).reduce((a, b) => a + b, 0);
    const width = Math.max(...Object.keys(rows).map((k) => k.length), 7);
    for (const [k, v] of Object.entries(rows).sort((a, b) => b[1] - a[1])) {
      console.log(`${k.padEnd(width)}  ${v.toLocaleString().padStart(14)}`);
    }
    console.log(`${'TOTAL'.padEnd(width)}  ${total.toLocaleString().padStart(14)}  (with a license value)`);
    return;
  }
  if (cmd === 'license') {
    const tokens = [...(opts.positionals ?? [])];
    if (opts.file) {
      tokens.push(...splitIds(opts.file === '-' ? readFileSync(0, 'utf8') : readFileSync(opts.file, 'utf8')));
    }
    if (!tokens.length) {
      if (process.stdin.isTTY) {
        throw new Error("No IDs provided (pass as args, --file, or via stdin). Try 'help'.");
      }
      tokens.push(...splitIds(readFileSync(0, 'utf8')));
    }
    if (!tokens.length) throw new Error('No IDs provided.');
    const mode = opts.idMode ?? 'pmid';
    const rows = await licenseById(tokens, { ...opts, idMode: mode });
    if (opts.json) {
      console.log(JSON.stringify(rows, null, 2));
      return;
    }
    const idCols = mode === 'pmcid' ? ['pmcid', 'pmid'] : [mode];
    const headers = [...idCols, 'license', 'is_oa'];
    const cells = rows.map((r) => {
      const lic = r.license ?? (r.id ? '-' : mode === 'pmcid' && !r.pmid ? '(no PMID in PMC)' : '(not found)');
      return [...idCols.map((c) => r[c] ?? '-'), lic, r.is_oa ?? '-'];
    });
    const widths = headers.map((h, i) => Math.max(h.length, ...cells.map((c) => String(c[i]).length)));
    console.log(headers.map((h, i) => h.padEnd(widths[i])).join('  '));
    for (const c of cells) {
      console.log(c.map((v, i) => String(v).padEnd(widths[i])).join('  '));
    }
    const matched = rows.filter((r) => r.id != null).length;
    process.stderr.write(`# matched ${matched}/${rows.length} IDs in OpenAlex\n`);
    return;
  }
  throw new Error(`Unknown command: ${cmd}. Try 'help'.`);
}

// Run as CLI only when executed directly (not when imported).
// realpath both sides: invoked via the ~/.local/bin symlink, argv[1] points at
// the link while import.meta.url is the resolved nix-store target.
if (process.argv[1] && import.meta.url === pathToFileURL(realpathSync(process.argv[1])).href) {
  main().catch((err) => {
    console.error('Error:', err.message);
    process.exit(1);
  });
}
