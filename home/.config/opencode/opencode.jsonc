{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "permission": {
    "external_directory": {
      "~/.firstmate": "allow",
      "~/.firstmate/**": "allow",
      "~/.treehouse": "allow",
      "~/.treehouse/**": "allow"
    }
  },
  // v1: autoupdate = true auto-installs updates, "notify" only says one
  // exists, false skips checks. (v2 renamed this to "update".)
  "autoupdate": true,
  "model": "cohere-agent-gateway/gpt-5.6-luna",
  "provider": {
    "cohere-oss": {
      "name": "Cohere OSS",
      "npm": "@ai-sdk/openai-compatible",
      "env": ["COHERE_API_KEY"],
      "options": {
        "baseURL": "https://api.oss-models-d8hv27.cloud.cohere.com/compatibility/v1/",
        "apiKey": "{env:COHERE_API_KEY}"
      },
      "models": {
        "glm-5-2-nvfp4": {
          "name": "GLM-5.2 (NVFP4)",
          "interleaved": "reasoning_content",
          "tool_call": true,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 320000,
            "output": 57680
          },
          "cost": {
            "input": 1.4,
            "output": 4.4,
            "cache_read": 0.26
          }
        },

        // GLM-5.2 FP8 is also available.
        // "glm-5-2-fp8": {
        //   "name": "GLM-5.2 (FP8)",
        //   "interleaved": "reasoning_content",
        //   "tool_call": true,
        //   "modalities": {
        //     "input": ["text"],
        //     "output": ["text"]
        //   },
        //   "limit": {
        //     "context": 270000,
        //     "output": 57680
        //   },
        //   "cost": {
        //     "input": 1.4,
        //     "output": 4.4,
        //     "cache_read": 0.26
        //   }
        // },

        "deepseek-v4-flash-0731": {
          "name": "DeepSeek V4 Flash 0731",
          "interleaved": "reasoning_content",
          "tool_call": true,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 1048576,
            "output": 32768
          },
          "cost": {
            "input": 0.14,
            "output": 0.28,
            "cache_read": 0.0028
          }
        }
      }
    },

    // Keep any existing providers here, separated by commas.
    // "cohere-staging": { ... },
    // "cohere": { ... }
    "cohere-llm-gateway": {
      "name": "LLM Gateway",
      "npm": "@ai-sdk/anthropic",
      "options": {
        "baseURL": "https://llm-gateway-acp-prod.tail5566.ts.net/v1",
        "apiKey": "dummy"
      },
      "models": {
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5"
        },
        "claude-opus-5": {
          "name": "Claude Opus 5"
        }
      }
    },

    "oss-model-vault-v2": {
      "name": "OSS Model Vault (V2)",
      "npm": "@ai-sdk/openai-compatible",
      "env": ["COHERE_API_KEY"],
      "options": {
        "baseURL": "https://api.oss-models-5kszmt.cloud.cohere.com/v1",
        "apiKey": "{env:COHERE_API_KEY}"
      },
      "models": {
        "kimi-k3-gb200": {
          "name": "Kimi K3",
          "interleaved": "reasoning",
          "tool_call": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 1048576,
            "output": 32768
          }
        },
        "glm-5-3-flash": {
          "name": "GLM-5.3 Flash",
          "interleaved": "reasoning",
          "tool_call": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        },
        "deepseek-v4-1-flash": {
          "name": "DeepSeek V4.1 Flash",
          "interleaved": "reasoning",
          "tool_call": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        },
        "mimo-v2-6-flash": {
          "name": "MiMo V2.6 Flash",
          "interleaved": "reasoning",
          "tool_call": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        },
        "mimo-v2-6-pro": {
          "name": "MiMo V2.6 Pro",
          "interleaved": "reasoning",
          "tool_call": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        },
        "kimi-k3-b200-pd-1p1d": {
          "name": "Kimi K3 (vLLM PD 1P1D)",
          "interleaved": "reasoning",
          "tool_call": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 1048576,
            "output": 32768
          }
        }
      }
    },
    "cohere-agent-gateway": {
      "name": "Cohere Agent Gateway",
      "npm": "@ai-sdk/openai",
      "options": {
        "baseURL": "https://llm-gateway-acp-prod.tail5566.ts.net/v1",
        "apiKey": "unused"
      },
      "models": {
        "gpt-5.5": { "name": "GPT-5.5" },
        "gpt-5.6-luna": { "name": "GPT-5.6 Luna" },
        "gpt-5.6-sol": { "name": "GPT-5.6 Sol" },
        "gpt-5.6-terra": { "name": "GPT-5.6 Terra" }
      }
    },
    "cohere-agent-gateway-chat": {
      "name": "Cohere Agent Gateway",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://llm-gateway-acp-prod.tail5566.ts.net/v1",
        "apiKey": "unused"
      },
      "models": {
        "claude-opus-4-6": { "name": "Claude Opus 4.6" },
        "claude-opus-4-8": { "name": "Claude Opus 4.8" },
        "claude-opus-5": { "name": "Claude Opus 5" },
        "claude-opus-5-5": { "name": "Claude Opus 5.5" },
        "claude-sonnet-4-5": { "name": "Claude Sonnet 4.5" },
        "claude-sonnet-5": { "name": "Claude Sonnet 5" },
        "command-a-plus-05-2026": { "name": "Command A+" },
        "command-bls-nightly": { "name": "Command BLS Nightly" },
        "command-bls-nightly-previous": { "name": "Command BLS Nightly Previous" },
        "gemma-4-31b": { "name": "Gemma 4 31B" },
        "north-mini-code-1-0": { "name": "North Mini Code" }
      }
    }
  },
  "mcp": {
    "agent-fabric": {
      "type": "remote",
      "url": "https://llm-gateway-acp-prod.tail5566.ts.net/mcp",
      "oauth": {
        "clientId": "system-mcp"
      }
    },
    // Linear's official hosted MCP (Streamable HTTP). OAuth 2.1 with dynamic
    // client registration: first use shows "needs authentication" in
    // `opencode mcp list` - sign in via /mcps inside the TUI. Credentials are
    // stored by opencode outside this config, so nothing secret lives in git.
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp"
    }
  }
}
