{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoshare": false,
  "autoupdate": true,
  "model": "oss-model-vault-v2/kimi-k3-gb200",
  "provider": {
    "cohere-oss": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cohere OSS",
      "options": {
        "baseURL": "https://api.oss-models-d8hv27.cloud.cohere.com/compatibility/v1/",
        "apiKey": "{env:COHERE_API_KEY}"
      },
      "models": {
        "glm-5-2-nvfp4": {
          "name": "GLM-5.2 (NVFP4)",
          "limit": {
            "context": 320000,
            "output": 57680
          },
          "interleaved": {
            "field": "reasoning_content"
          },
          "cost": {
            "input": 1.4,
            "cache_read": 0.26,
            "output": 4.4
          }
        },

        // GLM-5.2 FP8 is also available.
        // "glm-5-2-fp8": {
        //   "name": "GLM-5.2 (FP8)",
        //   "limit": {
        //     "context": 270000,
        //     "output": 57680
        //   },
        //   "interleaved": {
        //     "field": "reasoning_content"
        //   },
        //   "cost": {
        //     "input": 1.4,
        //     "cache_read": 0.26,
        //     "output": 4.4
        //   }
        // },

        "deepseek-v4-flash-0731": {
          "name": "DeepSeek V4 Flash 0731",
          "limit": {
            "context": 1048576,
            "output": 32768
          },
          "cost": {
            "input": 0.14,
            "cache_read": 0.0028,
            "output": 0.28
		      },
          "interleaved": {
            "field": "reasoning_content"
          }
        }
      }
    },

    // Keep any existing providers here, separated by commas.
    // "cohere-staging": { ... },
    // "cohere": { ... }
    "cohere-llm-gateway": {
      "npm": "@ai-sdk/anthropic",
      "name": "LLM Gateway",
      "options": {
        "baseURL": "https://llm-gateway-acp-prod.tail5566.ts.net/v1",
        "apiKey": "dummy"
      },
      "models": {
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5"
        },
        "claude-opus-5": {
          "name": "Claude Opus 5"
        }
      }
    },

    "oss-model-vault-v2": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OSS Model Vault (V2)",
      "options": {
        "baseURL": "https://api.oss-models-5kszmt.cloud.cohere.com/v1",
        "apiKey": "{env:COHERE_API_KEY}"
      },
      "models": {
        "kimi-k3-gb200": {
          "name": "Kimi K3",
          "reasoning": true,
          "tool_call": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          // Total context length is 1,000,000. Use the same 90%/10% split as
          // the other vault model.
          "limit": {
            "context": 900000,
            "output": 100000
          }
        }
      }
    }
  }
}
