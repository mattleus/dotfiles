#!/usr/bin/env bash
# pi-box: run Pi unrestricted inside a disposable container on colima's docker
# VM, so a full-power agent session can't touch the host.
#
# Only these enter the container, never the whole host $HOME:
#   - $PWD, read-write at the SAME absolute path (path parity, so git and
#     relative paths behave identically inside and out)
#   - ~/.pi/agent, read-write (models, settings, sessions, auth all persist)
#   - the repo-managed Pi config files from this checkout, bound over the
#     previous mount (see below)
set -euo pipefail

# Resolve this script's real path (it normally runs as the ~/.local/bin/pi-box
# symlink home-manager creates), so the repo's Dockerfile and Pi config are
# found however we're invoked. cd -P collapses symlinked path components like
# ~/.dotfiles, so repo_root ends up a physical path under /Users - the tree
# colima's VM shares with containers.
self="$0"
case "$self" in /*) ;; *) self="$(command -v "$self")";; esac
while [ -L "$self" ]; do
  target="$(readlink "$self")"
  case "$target" in /*) self="$target";; *) self="$(cd -P "$(dirname "$self")" && pwd)/$target";; esac
done
bin_dir="$(cd -P "$(dirname "$self")" && pwd)"
repo_root="$(cd -P "$bin_dir/../../.." && pwd)"
dockerfile="$repo_root/docker/agent-box/Dockerfile"
pi_config="$repo_root/home/.pi/agent"

# The docker daemon lives in colima's VM; this script checks but never starts,
# stops, or reconfigures it.
if ! colima status >/dev/null 2>&1; then
  echo "need: colima start" >&2
  exit 1
fi

# colima's VM only shares $HOME, and mounting all of it is off-limits anyway,
# so a project outside it (including $HOME itself) can't be mounted safely.
work_dir="$(pwd -P)"
case "$work_dir" in
  "$HOME"/*) ;;
  *) echo "pi-box: run from a project directory under $HOME" >&2; exit 1 ;;
esac

# Rebuild only when the Dockerfile changed: its sha256 is stored on the image
# as a label at build time, compared against the file on disk on each run.
want_hash="$(shasum -a 256 "$dockerfile" | awk '{print $1}')"
have_hash="$(docker image inspect agent-box:latest \
  --format '{{ index .Config.Labels "pi-box.dockerfile-sha256" }}' 2>/dev/null || true)"
if [ "$want_hash" != "$have_hash" ]; then
  docker build -t agent-box:latest \
    --label "pi-box.dockerfile-sha256=$want_hash" \
    -f "$dockerfile" "$repo_root/docker/agent-box"
fi

# Secrets pass through only when set on the host: docker would inject unset
# ones as empty strings, which reads as configured-but-broken auth inside.
env_args=(-e "TERM=${TERM:-xterm-256color}")
for var in COHERE_API_KEY GH_TOKEN GITHUB_TOKEN; do
  if [ -n "${!var:-}" ]; then
    env_args+=(-e "$var")
  fi
done

# Commits made inside the container reuse the identity git would use for this
# directory on the host (including the gitdir:-conditional includes).
git_name="$(git -C "$work_dir" config --get user.name 2>/dev/null || true)"
git_email="$(git -C "$work_dir" config --get user.email 2>/dev/null || true)"
if [ -n "$git_name" ]; then
  env_args+=(-e "GIT_AUTHOR_NAME=$git_name" -e "GIT_COMMITTER_NAME=$git_name")
fi
if [ -n "$git_email" ]; then
  env_args+=(-e "GIT_AUTHOR_EMAIL=$git_email" -e "GIT_COMMITTER_EMAIL=$git_email")
fi

# ~/.pi/agent's managed entries (models.json, settings.json, themes,
# extensions) are symlinks on the host whose targets live in the Nix store or
# ~/.dotfiles - both unreachable from the VM - so they would dangle inside.
# Bind the authoritative files from this checkout over them instead (the file
# mounts must follow the ~/.pi/agent directory mount). The JSONs go in
# read-write so in-container setting changes persist like host Pi's; themes
# and extensions are repo-authored, never written by Pi, so read-only.
exec docker run --rm -it \
  -v "$work_dir:$work_dir" \
  -v "$HOME/.pi/agent:/home/agent/.pi/agent" \
  -v "$pi_config/models.json:/home/agent/.pi/agent/models.json" \
  -v "$pi_config/settings.json:/home/agent/.pi/agent/settings.json" \
  -v "$pi_config/themes:/home/agent/.pi/agent/themes:ro" \
  -v "$pi_config/extensions:/home/agent/.pi/agent/extensions:ro" \
  "${env_args[@]}" \
  -w "$work_dir" \
  agent-box:latest "$@"
