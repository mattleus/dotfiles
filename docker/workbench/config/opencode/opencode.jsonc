// Baked workbench opencode config (sandbox spec, opencode v2 schema). Body
// mirrors the host's dotfiles-authored ~/.config/opencode/opencode.jsonc
// (providers resolve {env:COHERE_API_KEY} - secret-free by construction); the
// differences are the sandbox additions called out below. Seeded into place
// by workbench-init only when absent; runtime changes survive until the
// container is recreated, which is the point: agent guardrail config must
// reset with the container.
{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  // Sandbox: the image pins opencode; self-update would fight the pin.
  "update": "disable",
  "model": "oss-model-vault-v2/kimi-k3-gb200",

  // Sandbox additions (guardrails baked at the image layer). v2 permissions
  // are an ordered array; the last matching rule wins and these appended rules
  // follow opencode's base policy (allow everything; ask on external dirs and
  // .env reads). Everything here is either a default restated so it can never
  // be silently lost (.env deny tightened from the base ask, external_directory
  // ask), an enforceable reflex deny applied pre-tool-call even under --auto
  // (git push --force), or a blanket whole-action deny removing dead surface
  // (websearch - no search provider is configured in the sandbox). Enforceable
  // against the model, but pattern-matched on tool inputs: the container
  // boundary - not these rules - is what bounds indirection through bash.
  // (v1's doom_loop rule was dropped on migration: not a v2 action.)
  "permissions": [
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git push --force*", "effect": "deny" },
    { "action": "shell", "resource": "git push -f*", "effect": "deny" },
    { "action": "websearch", "resource": "*", "effect": "deny" }
  ],

  "providers": {
    "cohere-oss": {
      "name": "Cohere OSS",
      "package": "@opencode/ai/providers/openai-compatible",
      "env": ["COHERE_API_KEY"],
      "settings": {
        "baseURL": "https://api.oss-models-d8hv27.cloud.cohere.com/compatibility/v1/",
        "apiKey": "{env:COHERE_API_KEY}"
      },
      "models": {
        "glm-5-2-nvfp4": {
          "name": "GLM-5.2 (NVFP4)",
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 320000,
            "output": 57680
          },
          "cost": {
            "input": 1.4,
            "output": 4.4,
            "cache": {
              "read": 0.26
            }
          }
        },

        "deepseek-v4-flash-0731": {
          "name": "DeepSeek V4 Flash 0731",
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 1048576,
            "output": 32768
          },
          "cost": {
            "input": 0.14,
            "output": 0.28,
            "cache": {
              "read": 0.0028
            }
          }
        }
      }
    },

    // cohere-llm-gateway (tailnet) is unreachable from the sandbox - recorded
    // v1 limitation in the spec; left in config at host parity, never default.
    "cohere-llm-gateway": {
      "name": "LLM Gateway",
      "package": "@opencode/ai/providers/anthropic",
      "settings": {
        "baseURL": "https://llm-gateway-acp-prod.tail5566.ts.net/v1",
        "apiKey": "dummy"
      },
      "models": {
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5"
        },
        "claude-opus-5": {
          "name": "Claude Opus 5"
        }
      }
    },

    "oss-model-vault-v2": {
      "name": "OSS Model Vault (V2)",
      "package": "@opencode/ai/providers/openai-compatible",
      "env": ["COHERE_API_KEY"],
      "settings": {
        "baseURL": "https://api.oss-models-5kszmt.cloud.cohere.com/v1",
        "apiKey": "{env:COHERE_API_KEY}"
      },
      "models": {
        "kimi-k3-gb200": {
          "name": "Kimi K3",
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          // Total context length is 1,000,000. Use the same 90%/10% split as
          // the other vault model.
          "limit": {
            "context": 900000,
            "output": 100000
          }
        },
        "glm-5-3-flash": {
          "name": "GLM-5.3 Flash",
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "cost": {
            "input": 0.15,
            "output": 0.5,
            "cache": {
              "read": 0.03
            }
          }
        }
      }
    }
  }
}
