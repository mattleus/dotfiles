#!/bin/sh
# agentbox-init: PID 1 of the long-lived agentbox container (started by
# `agentbox up` with --entrypoint, as root; the image's own ENTRYPOINT stays
# `pi` for pi-box). Prepares sshd, materializes the session environment, then
# hands the process to sshd.
set -eu

mkdir -p /run/sshd
ssh-keygen -A >/dev/null

# Secrets + git identity: sshd gives login shells a scrubbed environment, so
# the container's own env never reaches agent sessions. Materialize it into
# agent's .zshenv - read by every zsh, login or not - refreshed from current
# env on every boot, so a rotated env file takes effect on container
# recreation.
{
  for var in COHERE_API_KEY GH_TOKEN GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL; do
    eval "val=\${$var:-}"
    if [ -n "$val" ]; then
      printf 'export %s=%s\n' "$var" "$(printf '%s' "$val" | sed "s/'/'\\\\''/g; s/.*/'&'/")"
    fi
  done
} > /Users/matt/.zshenv
chmod 600 /Users/matt/.zshenv
chown agent:agent /Users/matt/.zshenv

exec /usr/sbin/sshd -D -e
