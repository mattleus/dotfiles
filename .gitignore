# herdr runtime artifacts (regenerated at runtime; never commit)
home/.config/herdr/*.log
home/.config/herdr/session.json
home/.config/herdr/*.sock
home/.config/herdr/release-notes.json
# macOS + nix build noise
.DS_Store
result
result-*

# Pi credentials and Home Manager adoption backups stay local
/home/.pi/agent/auth.json
/home/.pi/agent/**/*.backup

# Pi Calm is a runtime toggle; its local state file is never tracked
/home/.pi/agent/calm

# no-mistakes local validation state - never commit in this public repo
.no-mistakes/

# Machine-local environment variables (API keys, tokens, etc) sourced by home.nix's
# zsh initContent - real values only ever live here, never in a tracked file.
/home/env.local

# agentbox env file lives at ~/.config/agentbox/env on the host (COHERE_API_KEY,
# GH_TOKEN, ssh keypair) - see README. It is never part of this repo; if a copy
# is ever stashed under the repo's home/ tree, it must not be committed.
/home/.config/agentbox/

# opencode skills are installed at runtime by the skills CLI (see installMattPocockSkills
# in home.nix) into ~/.config/opencode, which symlinks into this repo - never commit them.
/home/.config/opencode/skills/
